# Copy to apps/api/.env. Placeholders only. Do not commit the real password.
# Supabase dashboard → Project Settings → Database → Connection string.
# Use the direct URI (port 5432) for DIRECT_URL. Migrations fail on the
# transaction pooler (port 6543). DATABASE_URL may be the pooler for the API.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# development: dev tokens (Bearer dev:development:dev-traveller) plus JWT when
# JWT_SECRET is set. jwt: access JWT only (JWT_SECRET required).
AUTH_MODE=jwt
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=mittiandmiles-api
JWT_AUDIENCE=mittiandmiles-mobile
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

DATABASE_URL=postgresql://postgres:replace-me@db.project-ref.supabase.co:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:replace-me@db.project-ref.supabase.co:5432/postgres?sslmode=require

# unconfigured: order creation and webhooks are refused.
# sandbox: local signature-checked provider. Refused when NODE_ENV=production.
# razorpay: Razorpay Orders, payments, and refunds. Not Route or payout timing.
# Neither sandbox nor Razorpay confirms fund holding or delayed settlement.
PAYMENT_PROVIDER=unconfigured
# PAYMENT_SANDBOX_KEY_ID=sandbox-key
# PAYMENT_SANDBOX_KEY_SECRET=replace-with-16-plus-characters
# PAYMENT_SANDBOX_WEBHOOK_SECRET=replace-with-16-plus-characters
# RAZORPAY_KEY_ID=rzp_test_replace_me
# RAZORPAY_KEY_SECRET=replace-with-key-secret
# RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret
